<Email.styles dark_scope="[data-theme=dark]" />
<Email.layout
  preheader="Join the workspace and see projects, contracts and PRs."
  brand_name="DevAction IA"
  brand_href="#"
  logo_src="/images/email-logo.png"
  signature="DevAction Labs · Feira de Santana, BA"
>
  <Email.byline initials="CA">
    <Email.emphasis>Carlos André</Email.emphasis>
    invited you to the workspace <Email.emphasis>DevAction Labs</Email.emphasis>.
  </Email.byline>
  <Email.heading>Join DevAction Labs</Email.heading>
  <Email.paragraph>
    You will see the projects, contracts and PRs of the team, and the AI starts to review your PRs too.
  </Email.paragraph>
  <EmailTag.chip tone={:info}>ROLE: MEMBER</EmailTag.chip>
  <Email.button href="#">Accept invite</Email.button>
  <Email.paragraph size={:small} flush>
    The invite works for 7 days. If you did not expect this e-mail, you can ignore it.
  </Email.paragraph>
  <:footer>
    You got this e-mail because you have a DevAction IA account. It is automatic: replies are not read.
  </:footer>
</Email.layout>
