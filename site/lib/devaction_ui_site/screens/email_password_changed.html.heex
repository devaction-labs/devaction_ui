<Email.styles dark_scope="[data-theme=dark]" />
<Email.layout
  preheader="We ended the other sessions for safety."
  brand_name="DevAction IA"
  brand_href="#"
  logo_src="/images/email-logo.png"
  signature="DevAction Labs · Feira de Santana, BA"
>
  <Email.heading>Your password was changed</Email.heading>
  <Email.paragraph>
    Hi, Alex. The password of your account was just changed. For safety, we ended the sessions on your other devices.
  </Email.paragraph>
  <EmailTable.details>
    <:row label="When">Oct 16, 2026 at 09:12</:row>
    <:row label="Device">Firefox on Linux</:row>
  </EmailTable.details>
  <EmailCallout.callout tone={:risk} lead="Was it not you?">
    Reset your password now and review the connected devices.
  </EmailCallout.callout>
  <Email.button href="#" variant={:secondary}>Reset password</Email.button>
  <:footer>
    You got this e-mail because you have a DevAction IA account. It is automatic: replies are not read.
  </:footer>
</Email.layout>
