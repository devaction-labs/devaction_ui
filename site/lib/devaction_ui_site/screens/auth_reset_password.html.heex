<AuthLayout.auth_layout
  about_label="About DevAction IA"
  headline="Contracts, code and learning in the same place."
  copyright="© 2026 DevAction Labs"
>
  <:brand>
    <span class="grid size-[34px] place-items-center rounded-[9px] border border-line-strong bg-[#060C1F]">
      <svg width="32" height="32" viewBox="50 50 1154 1154" aria-hidden="true">
        <path
          d="M395 303 H728 L912 492 Q968 552 968 628 Q968 706 905 770 L828 832 Q834 800 812 776 L392 330 Q380 314 395 303 Z"
          fill="#FFFFFF"
        />
        <path
          d="M628 662 Q641 650 654 662 L797 808 Q812 826 797 843 L722 935 Q712 945 698 945 H388 Q366 945 380 925 Z"
          fill="#E3A72F"
        />
      </svg>
    </span>
    <span class="text-lg font-semibold tracking-[-0.01em]">DevAction IA</span>
  </:brand>

  <:feature
    title="PR review with AI"
    text="The AI reads the diff, points out risks and suggests the fix before the merge."
  >
    <.icon name="git-pull-request" class="size-[18px]" />
  </:feature>
  <:feature
    title="Contracts with milestones"
    text="Scope, amendments and invoicing tied to what the team delivers."
  >
    <.icon name="contracts" class="size-[18px]" />
  </:feature>
  <:feature
    title="Learn from what you ship"
    text="Every review becomes a short lesson on your path."
  >
    <.icon name="book-02" class="size-[18px]" />
  </:feature>

  <:link href="#">Terms</:link>
  <:link href="#">Privacy</:link>
  <:link href="#">Status</:link>

  <AuthCard.auth_card title="Create a new password" icon_class="bg-tag-warn-bg">
    <:icon>
      <.icon name="lock-password" class="size-7 text-tag-warn-text" />
    </:icon>
    <:subtitle>
      For <strong class="font-semibold text-ink">alex@devaction.com.br</strong>. Use at least 12 characters.
    </:subtitle>

    <% strength = PasswordStrength.evaluate("") %>
    <form id="reset-password-form" class="flex flex-col gap-5">
      <div class="flex flex-col gap-3">
        <label class="flex flex-col gap-2 text-sm font-medium text-ink-2">
          New password
          <InputGroup.input_group
            id="reset-password"
            name="password"
            type="password"
            placeholder="At least 12 characters"
            autocomplete="new-password"
          >
            <:action>
              <InputGroup.input_action
                label="Show the password"
                phx-click={
                  JS.toggle_attribute({"type", "text", "password"}, to: "#reset-password")
                }
              >
                <.icon name="view" class="size-[18px]" />
              </InputGroup.input_action>
            </:action>
          </InputGroup.input_group>
        </label>
        <PasswordStrength.password_strength
          score={strength.score}
          label="Type a password"
          rules={[
            %{label: "At least 12 characters", met: strength.rules[:length]},
            %{label: "Capital and small letters", met: strength.rules[:mixed_case]},
            %{label: "A number or a symbol", met: strength.rules[:digit_or_symbol]}
          ]}
        >
          <:met_icon><.icon name="checkmark-circle-02" class="size-4" /></:met_icon>
          <:unmet_icon><.icon name="clock-01" class="size-4" /></:unmet_icon>
        </PasswordStrength.password_strength>
      </div>
      <label class="flex flex-col gap-2 text-sm font-medium text-ink-2">
        Confirm new password
        <InputGroup.input_group
          id="reset-password-confirm"
          name="password_confirmation"
          type="password"
          placeholder="Repeat the password"
          autocomplete="new-password"
        />
      </label>
      <p class="m-0 flex items-start gap-2 text-[13px] leading-normal text-muted">
        <.icon name="shield-01" class="mt-px size-4 shrink-0" />
        For your security, you are signed out of all connected devices.
      </p>
      <Button.button type="submit" variant={:primary} disabled class="w-full font-semibold">
        Save new password
      </Button.button>
    </form>
  </AuthCard.auth_card>
</AuthLayout.auth_layout>
