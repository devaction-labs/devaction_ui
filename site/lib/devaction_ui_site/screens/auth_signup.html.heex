<AuthLayout.auth_layout
  about_label="About DevAction IA"
  headline="Contracts, code and learning in the same place."
  copyright="© 2026 DevAction Labs"
>
  <:brand>
    <span class="grid size-[34px] place-items-center rounded-[9px] border border-line-strong bg-[#060C1F]">
      <svg width="32" height="32" viewBox="50 50 1154 1154" aria-hidden="true">
        <path
          d="M395 303 H728 L912 492 Q968 552 968 628 Q968 706 905 770 L828 832 Q834 800 812 776 L392 330 Q380 314 395 303 Z"
          fill="#FFFFFF"
        />
        <path
          d="M628 662 Q641 650 654 662 L797 808 Q812 826 797 843 L722 935 Q712 945 698 945 H388 Q366 945 380 925 Z"
          fill="#E3A72F"
        />
      </svg>
    </span>
    <span class="text-lg font-semibold tracking-[-0.01em]">DevAction IA</span>
  </:brand>

  <:feature
    title="PR review with AI"
    text="The AI reads the diff, points out risks and suggests the fix before the merge."
  >
    <.icon name="git-pull-request" class="size-[18px]" />
  </:feature>
  <:feature
    title="Contracts with milestones"
    text="Scope, amendments and invoicing tied to what the team delivers."
  >
    <.icon name="contracts" class="size-[18px]" />
  </:feature>
  <:feature
    title="Learn from what you ship"
    text="Every review becomes a short lesson on your path."
  >
    <.icon name="book-02" class="size-[18px]" />
  </:feature>

  <:link href="#">Terms</:link>
  <:link href="#">Privacy</:link>
  <:link href="#">Status</:link>

  <AuthCard.auth_card
    title="Create your account"
    text="Takes under a minute. Connect GitHub and your repositories join the review."
    icon_class="bg-[#060C1F]"
  >
    <:icon>
      <svg width="52" height="52" viewBox="50 50 1154 1154" aria-hidden="true">
        <path
          d="M395 303 H728 L912 492 Q968 552 968 628 Q968 706 905 770 L828 832 Q834 800 812 776 L392 330 Q380 314 395 303 Z"
          fill="#FFFFFF"
        />
        <path
          d="M628 662 Q641 650 654 662 L797 808 Q812 826 797 843 L722 935 Q712 945 698 945 H388 Q366 945 380 925 Z"
          fill="#E3A72F"
        />
      </svg>
    </:icon>

    <Button.button variant={:primary} class="w-full font-semibold">
      <.icon name="github" class="size-[18px]" /> Continue with GitHub
    </Button.button>

    <Divider.divider label="or" />

    <form id="signup-form" class="flex flex-col gap-5">
      <label class="flex flex-col gap-2 text-sm font-medium text-ink-2">
        Name
        <InputGroup.input_group
          id="signup-name"
          name="name"
          type="text"
          placeholder="What should we call you"
          autocomplete="name"
        />
      </label>
      <label class="flex flex-col gap-2 text-sm font-medium text-ink-2">
        Work e-mail
        <InputGroup.input_group
          id="signup-email"
          name="email"
          type="email"
          placeholder="you@company.com"
          autocomplete="email"
        />
      </label>
      <Button.button type="submit" variant={:secondary} class="w-full">
        Continue with e-mail
      </Button.button>
      <p class="m-0 text-center text-xs leading-normal text-muted">
        By continuing, you accept the
        <a href="#" class="text-ink-2 underline hover:text-ink">Terms</a>
        and the <a href="#" class="text-ink-2 underline hover:text-ink">Privacy policy</a>.
      </p>
    </form>

    <:footer>
      Already have an account?
      <a href="#" class="font-medium text-ink no-underline hover:underline">Sign in</a>
    </:footer>
  </AuthCard.auth_card>
</AuthLayout.auth_layout>
