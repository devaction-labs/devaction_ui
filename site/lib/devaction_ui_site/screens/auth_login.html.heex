<AuthLayout.auth_layout
  about_label="About DevAction IA"
  nav_label="Legal"
  headline="Contracts, code and learning in the same place."
  copyright="© 2026 DevAction Labs"
>
  <:brand>
    <AuthLayout.auth_brand name="DevAction IA">
      <:mark>
        <svg width="32" height="32" viewBox="50 50 1154 1154" aria-hidden="true">
          <path
            d="M395 303 H728 L912 492 Q968 552 968 628 Q968 706 905 770 L828 832 Q834 800 812 776 L392 330 Q380 314 395 303 Z"
            fill="#FFFFFF"
          />
          <path
            d="M628 662 Q641 650 654 662 L797 808 Q812 826 797 843 L722 935 Q712 945 698 945 H388 Q366 945 380 925 Z"
            fill="#E3A72F"
          />
        </svg>
      </:mark>
    </AuthLayout.auth_brand>
  </:brand>

  <:feature
    title="PR review with AI"
    text="The AI reads the diff, points out risks and suggests the fix before the merge."
  >
    <.icon name="git-pull-request" class="size-[18px]" />
  </:feature>
  <:feature
    title="Contracts with milestones"
    text="Scope, amendments and invoicing tied to what the team delivers."
  >
    <.icon name="contracts" class="size-[18px]" />
  </:feature>
  <:feature
    title="Learn from what you ship"
    text="Every review becomes a short lesson on your path."
  >
    <.icon name="book-02" class="size-[18px]" />
  </:feature>

  <:link href="#">Terms</:link>
  <:link href="#">Privacy</:link>
  <:link href="#">Status</:link>

  <AuthCard.auth_card
    title="Welcome back"
    text="Sign in with GitHub or get an access link in your e-mail."
    icon_tone={:brand}
  >
    <:icon>
      <svg width="52" height="52" viewBox="50 50 1154 1154" aria-hidden="true">
        <path
          d="M395 303 H728 L912 492 Q968 552 968 628 Q968 706 905 770 L828 832 Q834 800 812 776 L392 330 Q380 314 395 303 Z"
          fill="#FFFFFF"
        />
        <path
          d="M628 662 Q641 650 654 662 L797 808 Q812 826 797 843 L722 935 Q712 945 698 945 H388 Q366 945 380 925 Z"
          fill="#E3A72F"
        />
      </svg>
    </:icon>

    <Button.button variant={:secondary} class="w-full">
      <.icon name="github" class="size-[18px]" /> Continue with GitHub
    </Button.button>

    <Divider.divider label="or" />

    <Tabs.tabs id="login-mode" label="Way to sign in" full>
      <:tab id="magic" label="Magic link" selected>
        <form id="magic-link-form" class="flex flex-col gap-5 pt-5">
          <label class="flex flex-col gap-2 text-sm font-medium text-ink-2">
            E-mail
            <InputGroup.input_group
              id="magic-email"
              name="email"
              type="email"
              placeholder="you@company.com"
              autocomplete="email"
            />
          </label>
          <Button.button type="submit" variant={:primary} class="w-full font-semibold">
            <.icon name="mail-01" class="size-[18px]" /> Send access link
          </Button.button>
          <p class="m-0 flex items-start gap-2 text-[13px] leading-normal text-muted">
            <.icon name="information-circle" class="mt-px size-4 shrink-0" />
            No password: you click the link in the e-mail and you are in. It lasts 15 minutes.
          </p>
        </form>
      </:tab>
      <:tab id="password" label="Password">
        <form id="password-form" class="flex flex-col gap-5 pt-5">
          <label class="flex flex-col gap-2 text-sm font-medium text-ink-2">
            E-mail
            <InputGroup.input_group
              id="password-email"
              name="email"
              type="email"
              placeholder="you@company.com"
              autocomplete="email"
            />
          </label>
          <label class="flex flex-col gap-2 text-sm font-medium text-ink-2">
            <span class="flex items-baseline justify-between">
              Password
              <a href="#" class="text-[13px] font-normal text-muted underline hover:text-ink">Forgot it?</a>
            </span>
            <InputGroup.input_group
              id="password-field"
              name="password"
              type="password"
              placeholder="Your password"
              autocomplete="current-password"
            >
              <:action>
                <InputGroup.input_action
                  label="Show the password"
                  phx-click={
                    JS.toggle_attribute({"type", "text", "password"}, to: "#password-field")
                  }
                >
                  <.icon name="view" />
                </InputGroup.input_action>
              </:action>
            </InputGroup.input_group>
          </label>
          <Button.button type="submit" variant={:primary} class="w-full font-semibold">
            Sign in
          </Button.button>
        </form>
      </:tab>
    </Tabs.tabs>

    <:footer>
      No account?
      <a href="#" class="font-medium text-ink no-underline hover:underline">Create one</a>
    </:footer>
  </AuthCard.auth_card>
</AuthLayout.auth_layout>
