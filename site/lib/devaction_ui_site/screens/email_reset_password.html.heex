<Email.styles dark_scope="[data-theme=dark]" />
<Email.layout
  preheader="Create a new password. The link works for 1 hour."
  brand_name="DevAction IA"
  brand_href="#"
  logo_src="/images/email-logo.png"
  signature="DevAction Labs · Feira de Santana, BA"
>
  <Email.heading>Reset your password</Email.heading>
  <Email.paragraph>
    Hi, Alex. Click the button to create a new password. The link works for <Email.emphasis>1 hour</Email.emphasis>.
  </Email.paragraph>
  <Email.button href="#">Create new password</Email.button>
  <EmailCallout.callout tone={:warn}>
    Need to sign in right now? Use the magic link on the sign-in screen. You change the password later, in Account and security.
  </EmailCallout.callout>
  <Email.link_fallback href="https://app.devaction.com.br/users/reset-password/Lm3cY6hVn9">
    If the button does not work, copy and paste this address in your browser:
  </Email.link_fallback>
  <Email.divider />
  <Email.paragraph size={:small} flush>
    If you did not ask for this, ignore this e-mail. Your current password stays valid.
  </Email.paragraph>
  <:footer>
    You got this e-mail because you have a DevAction IA account. It is automatic: replies are not read.
  </:footer>
</Email.layout>
