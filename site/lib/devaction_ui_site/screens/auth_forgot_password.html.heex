<AuthLayout.auth_layout
  about_label="About DevAction IA"
  nav_label="Legal"
  headline="Contracts, code and learning in the same place."
  copyright="© 2026 DevAction Labs"
>
  <:brand>
    <AuthLayout.auth_brand name="DevAction IA">
      <:mark>
        <svg width="32" height="32" viewBox="50 50 1154 1154" aria-hidden="true">
          <path
            d="M395 303 H728 L912 492 Q968 552 968 628 Q968 706 905 770 L828 832 Q834 800 812 776 L392 330 Q380 314 395 303 Z"
            fill="#FFFFFF"
          />
          <path
            d="M628 662 Q641 650 654 662 L797 808 Q812 826 797 843 L722 935 Q712 945 698 945 H388 Q366 945 380 925 Z"
            fill="#E3A72F"
          />
        </svg>
      </:mark>
    </AuthLayout.auth_brand>
  </:brand>

  <:feature
    title="PR review with AI"
    text="The AI reads the diff, points out risks and suggests the fix before the merge."
  >
    <.icon name="git-pull-request" class="size-[18px]" />
  </:feature>
  <:feature
    title="Contracts with milestones"
    text="Scope, amendments and invoicing tied to what the team delivers."
  >
    <.icon name="contracts" class="size-[18px]" />
  </:feature>
  <:feature
    title="Learn from what you ship"
    text="Every review becomes a short lesson on your path."
  >
    <.icon name="book-02" class="size-[18px]" />
  </:feature>

  <:link href="#">Terms</:link>
  <:link href="#">Privacy</:link>
  <:link href="#">Status</:link>

  <AuthCard.auth_card
    title="Forgot your password?"
    text="Enter your e-mail and we will send you a link to create a new one."
    icon_class="border-tag-warn-line bg-tag-warn-bg text-ai"
  >
    <:icon>
      <.icon name="key-01" class="size-6" />
    </:icon>

    <form id="forgot-password-form" class="flex flex-col gap-5">
      <label class="flex flex-col gap-2 text-sm font-medium text-ink-2">
        E-mail
        <InputGroup.input_group
          id="forgot-email"
          name="email"
          type="email"
          placeholder="you@company.com"
          autocomplete="email"
        />
      </label>
      <Button.button type="submit" variant={:primary} class="w-full font-semibold">
        Send reset link
      </Button.button>
    </form>

    <.callout kind={:warn} class="p-[12px] text-[13px]">
      <:icon><.icon name="magic-wand-01" class="size-4" /></:icon>
      Need to get in right now?
      <a href="#" class="text-tag-warn-text underline">Use the magic link</a>
      and change your password later, in Account and security.
    </.callout>

    <a
      href="#"
      class="flex items-center justify-center gap-1.5 text-sm text-muted no-underline hover:text-ink"
    >
      <.icon name="arrow-left-01" class="size-4" /> Back to sign in
    </a>
  </AuthCard.auth_card>
</AuthLayout.auth_layout>
