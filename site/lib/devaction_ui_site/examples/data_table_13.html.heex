<%!-- title: Cards on the phone | text: With `stack` each row becomes a card under 640px. The `primary` column is its title and every other cell takes the label of its column as a caption. Narrow the window to see it. --%>
<DataTable.data_table
  select_all_label="Select all"
  select_row_label="Select row"
  selected_label="__COUNT__ selected"
  clear_label="Clear"
  id="data-table-stack"
  label="Pull requests"
  stack
  rows={[
    %{
      id: "142",
      title: "Tithe in transaction",
      author: "carlos-andre",
      changes: 187,
      status: "open"
    },
    %{
      id: "145",
      title: "Refunds and CSV export",
      author: "carlos-andre",
      changes: 120,
      status: "open"
    },
    %{
      id: "63",
      title: "Search with filters",
      author: "alex-nogueira",
      changes: 33,
      status: "merged"
    },
    %{id: "58", title: "Webhook retries", author: "alex-nogueira", changes: 74, status: "merged"}
  ]}
>
  <:col :let={row} label="Title" primary>{row.title}</:col>
  <:col :let={row} label="PR" mono>#{row.id}</:col>
  <:col :let={row} label="Author" class="text-ink-2">{row.author}</:col>
  <:col :let={row} label="Changes" align={:end} mono>{row.changes}</:col>
</DataTable.data_table>
