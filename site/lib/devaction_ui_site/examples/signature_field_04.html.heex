<%!-- title: Guide text and font | text: guide_label writes under the line of the pad; typed_label labels the name field; font swaps the face of the typed name (load it on the page). --%>
<div class="max-w-lg">
  <SignatureField.signature_field
    id="signature-guide"
    name="guide_signature"
    mode={:type}
    typed="Maria Souza"
    label="Sign the addendum"
    mode_event="sign_mode"
    draw_label="Draw"
    type_label="Type"
    clear_label="Clear"
    pad_label="Signature area"
    guide_label="Sign above the line"
    typed_label="Full name"
    font="'Brush Script MT', cursive"
    required
  >
    <:clear_icon><.icon name="refresh" class="size-4" /></:clear_icon>
  </SignatureField.signature_field>
</div>
