<%!-- title: Case | text: Normal case keeps a value that is code from turning into capitals. | layout: center --%>
<div class="flex flex-wrap items-center gap-2">
  <.tag variant={:info}>upper</.tag>
  <.tag variant={:info} case={:normal}>phx-click</.tag>
  <.tag variant={:neutral} case={:normal}>feature/payments</.tag>
  <.tag variant={:risk} case={:normal} size={:sm}>:error</.tag>
</div>
