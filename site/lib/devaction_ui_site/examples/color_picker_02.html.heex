<%!-- title: With opacity | text: `alpha` adds a strip and the value gains two hex digits --%>
<div class="min-h-[22rem]">
  <ColorPicker.color_picker
    id="color-alpha"
    name="highlight[color]"
    value="#D29A1EB3"
    label="Highlight colour"
    alpha
    toggle_label="Open the colour picker"
    area_label="Saturation and brightness"
    hue_label="Hue"
    alpha_label="Opacity"
    presets_label="Ready colours"
  />
</div>
