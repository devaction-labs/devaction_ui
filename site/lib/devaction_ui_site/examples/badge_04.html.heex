<%!-- title: Pulsing | text: A pulse draws the eye to something running now | layout: center --%>
<div class="flex flex-wrap items-center gap-4">
  <Badge.dot pulse tone={:ok} label="Live" />
  <Badge.dot pulse tone={:warn} label="Running" />
  <Badge.dot pulse tone={:risk} label="Incident" />
</div>
