<%!-- title: Create what is missing | text: With `create` and `on_create`, the last row offers the text typed when no option is called that; the LiveView gets `%{"id", "term"}` and adds it --%>
<Listbox.listbox
  id="listbox-create"
  name="tag"
  label="Tag"
  placeholder="Choose a tag"
  searchable
  search_placeholder="Search or create"
  empty="No tag for “%{term}”"
  create="Create “%{term}”"
  on_create="create_tag"
  class="max-w-sm"
  options={[
    %{value: "bug", label: "Bug"},
    %{value: "feature", label: "Feature"},
    %{value: "chore", label: "Chore"}
  ]}
>
  <:chevron_icon><.icon name="arrow-down-01" class="size-4" /></:chevron_icon>
  <:search_icon><.icon name="search-01" class="size-4" /></:search_icon>
  <:check_icon><.icon name="tick-02" class="size-4" /></:check_icon>
  <:create_icon><.icon name="add-01" class="size-4" /></:create_icon>
</Listbox.listbox>
