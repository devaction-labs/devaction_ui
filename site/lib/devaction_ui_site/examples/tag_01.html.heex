<%!-- title: Variants | text: The variant says what the tag means, not its color. | layout: center --%>
<div class="flex flex-wrap items-center gap-2">
  <.tag variant={:risk}>At risk</.tag>
  <.tag variant={:warn}>Waiting</.tag>
  <.tag variant={:ok}>On track</.tag>
  <.tag variant={:info}>Planned</.tag>
  <.tag variant={:neutral}>Draft</.tag>
</div>
