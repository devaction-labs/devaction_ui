<%!-- title: Prefilled | text: Existing values come back as removable pills. --%>
<div class="max-w-md">
  <Pillbox.pillbox
    id="pillbox-prefilled"
    name="labels"
    values={["backend", "urgent", "needs-review"]}
    label="Labels"
    placeholder="Add a label"
    remove_label="Remove"
  />
</div>
