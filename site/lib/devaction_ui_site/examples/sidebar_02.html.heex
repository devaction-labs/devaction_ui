<%!-- title: Collapsed | text: Only the icons remain, with the label as a tooltip. --%>
<div class="flex gap-4 rounded-2xl bg-frame p-4">
  <Sidebar.sidebar
    id="sidebar-collapsed"
    label="Main, collapsed"
    collapsed
    on_toggle="shell_collapse"
    toggle_label="Open the menu"
  >
    <:toggle_icon><.icon name="arrow-down-01" class="size-5 rotate-90" /></:toggle_icon>
    <:icon :let={item}><.icon name={sidebar_icon(item.label)} class="size-5" /></:icon>
    <:item to="/c/sidebar" label="Today" current />
    <:item to="/c/sidebar" label="Projects" count="4" />
    <:item to="/c/sidebar" label="Contracts" />
    <:item to="/c/sidebar" label="Review" count="3" />
  </Sidebar.sidebar>
  <div class="flex flex-1 items-center justify-center rounded-xl border border-dashed border-line-strong text-sm text-muted">
    The screen
  </div>
</div>
