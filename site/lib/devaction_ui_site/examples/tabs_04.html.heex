<%!-- title: Selected tab | text: Mark which tab is open on first render. --%>
<Tabs.tabs id="tabs-selected" label="Contract" variant={:line}>
  <:tab id="tabs-selected-terms" label="Terms">Payment terms and notice period.</:tab>
  <:tab id="tabs-selected-scope" label="Scope" selected>Scope items grouped by milestone.</:tab>
  <:tab id="tabs-selected-invoices" label="Invoices" count="2">Two invoices are pending.</:tab>
</Tabs.tabs>
