<%!-- title: Sizes | text: Size is set with plain classes on the shape. --%>
<div class="flex items-end gap-6">
  <.skeleton shape={:circle} class="size-6" />
  <.skeleton shape={:circle} class="size-10" />
  <.skeleton shape={:circle} class="size-16" />
  <.skeleton shape={:block} class="h-8 w-24" />
  <.skeleton shape={:block} class="h-20 w-40" />
</div>
