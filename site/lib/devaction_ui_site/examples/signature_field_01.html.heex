<%!-- title: Draw | text: Sign with the mouse, a finger or a pen. --%>
<div class="max-w-lg">
  <SignatureField.signature_field
    id="signature-draw"
    name="contract_signature"
    mode={:draw}
    label="Sign the contract"
    mode_event="sign_mode"
    draw_label="Draw"
    type_label="Type"
    clear_label="Clear"
    pad_label="Signature area"
    empty_label="Signature empty"
    ready_label="Ready to sign"
    hint="Draw with the mouse, the finger or the pen."
  >
    <:clear_icon><.icon name="refresh" class="size-4" /></:clear_icon>
  </SignatureField.signature_field>
</div>
