<%!-- title: From the left | text: Side left, in the narrow 384 px width --%>
<Button.button
  id="drawer-03-open"
  variant={:secondary}
  size={:sm}
  class="self-start"
  phx-click={Drawer.open(JS.push("overlay_open", value: %{kind: "drawer_left"}))}
>
  Open from the left
</Button.button>
<Drawer.drawer
  :if={@overlays.kind == "drawer_left"}
  id="drawer-03"
  variant={:floating}
  side={:left}
  size={:sm}
  on_close="overlay_close"
  close_label="Close"
>
  <:close_icon><.icon name="cancel-01" class="size-4" /></:close_icon>
  <:title>Edit profile</:title>
  <:subtitle>Change your personal data.</:subtitle>
  <label class="flex flex-col gap-1.5 text-sm font-medium">
    Name <InputGroup.input_group id="drawer-03-name" value="Alex Nogueira" />
  </label>
  <label class="flex flex-col gap-1.5 text-sm font-medium">
    About you
    <Textarea.textarea id="drawer-03-about" rows={3} value="Elixir and Phoenix, code review." />
  </label>
  <:footer>
    <Button.button id="drawer-03-cancel" phx-click="overlay_close">Cancel</Button.button>
    <Button.button id="drawer-03-save" variant={:primary} phx-click="overlay_close">Save changes</Button.button>
  </:footer>
</Drawer.drawer>
