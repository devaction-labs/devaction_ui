<%!-- title: Live stack | text: Each click adds a notice at the bottom right of the screen --%>
<Button.button
  id="toast-group-add"
  variant={:primary}
  size={:sm}
  phx-click="add_toast"
  class="self-start"
>
  Add a notice
</Button.button>
<ToastGroup.toast_group
  :if={@toasts != []}
  id="toast-group-live"
  label="Notices"
  on_dismiss="dismiss_toast"
  on_clear="clear_toasts"
  expand_label="Show all"
  collapse_label="Collapse"
  clear_label="Clear"
  dismiss_label="Close"
  count_label="__COUNT__ notices"
  class="fixed right-4 bottom-4 z-50 w-[380px]"
>
  <:toast
    :for={toast <- @toasts}
    id={toast.id}
    kind={toast.kind}
    title={toast.title}
    duration={0}
  />
</ToastGroup.toast_group>
