<%!-- title: Action | text: The button sends its event back to the LiveView, or to the target, with the value you gave it. --%>
<div class="grid w-full gap-3">
  <Button.button
    id="toast-action-delete"
    variant={:secondary}
    size={:sm}
    phx-click="toast_delete"
    class="self-start"
  >
    Delete task
  </Button.button>
  <div class="flex h-[100px] items-end">
    <ToastGroup.toast_group
      id="toast-action"
      inline
      duration={10000}
      label="Notifications (Alt+T)"
      dismiss_label="Close"
    />
  </div>
  <p id="toast-action-received" class="m-0 font-mono text-[13px] text-muted">
    {@toast_received || "The server has not received an event yet."}
  </p>
</div>
