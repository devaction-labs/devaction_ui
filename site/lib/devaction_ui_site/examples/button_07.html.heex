<%!-- title: As a Link | text: With navigate, patch or href it renders a link styled as a button | layout: center --%>
<div class="flex flex-wrap items-center gap-2.5">
  <Button.button navigate="/dev/ui" variant={:primary}>Open dashboard</Button.button>
  <Button.button href="https://hexdocs.pm" target="_blank" rel="noopener" variant={:info}>
    Read the docs
  </Button.button>
</div>
