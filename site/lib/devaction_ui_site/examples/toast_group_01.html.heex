<%!-- title: Try it | text: Fire a few toasts and point at the pile. Closed, only the front one shows and two peek behind it; open, it is a list. --%>
<div class="grid w-full gap-3">
  <div class="flex flex-wrap gap-2">
    <Button.button
      :for={
        {kind, label} <-
          [
            {"ok", "Saved"},
            {"ai", "AI"},
            {"action", "With action"},
            {"warn", "Warning"},
            {"risk", "Error"},
            {"loading", "Loading"}
          ]
      }
      id={"toast-try-#{kind}"}
      variant={:secondary}
      size={:sm}
      phx-click="toast_push"
      phx-value-kind={kind}
    >
      {label}
    </Button.button>
    <Button.button id="toast-try-clear" variant={:ghost} size={:sm} phx-click="toast_clear">
      Clear
    </Button.button>
  </div>
  <div class="flex h-[520px] items-end">
    <ToastGroup.toast_group
      id="toast-try"
      inline
      label="Notifications (Alt+T)"
      dismiss_label="Close"
    />
  </div>
</div>
