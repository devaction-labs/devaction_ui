<%!-- title: Basic | text: A hex field with a swatch; the swatch or the field opens the panel --%>
<div class="min-h-[22rem]">
  <ColorPicker.color_picker
    id="color-basic"
    name="project[color]"
    value="#2563EB"
    label="Project colour"
    toggle_label="Open the colour picker"
    area_label="Saturation and brightness"
    hue_label="Hue"
    presets_label="Ready colours"
  />
</div>
