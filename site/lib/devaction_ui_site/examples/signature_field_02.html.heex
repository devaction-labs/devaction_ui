<%!-- title: Type | text: The typed name is rendered as a signature. --%>
<div class="max-w-lg">
  <SignatureField.signature_field
    id="signature-type"
    name="approval_signature"
    mode={:type}
    typed="Maria Souza"
    label="Approve the milestone"
    mode_event="sign_mode"
    draw_label="Draw"
    type_label="Type"
    clear_label="Clear"
    hint="Type your full name."
  />
</div>
