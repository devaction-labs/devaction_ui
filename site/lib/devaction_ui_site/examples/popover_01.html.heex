<%!-- title: Basic | text: A panel with an arrow, anchored to its trigger | layout: center --%>
<div class="pb-32">
  <Popover.popover id="popover-basic" label="Pull request details">
    <:trigger>
      <Button.button variant={:secondary} size={:sm}>PR #142</Button.button>
    </:trigger>
    <p class="m-0 font-semibold text-ink">Wrap tithes in a transaction</p>
    <p class="m-0 mt-1 text-sm text-ink-2">Opened by Alex, waiting for review.</p>
  </Popover.popover>
</div>
