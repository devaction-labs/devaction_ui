<%!-- title: Kinds | text: Info, ok, ai and risk, each with a title and a body --%>
<Alert.alert kind={:info} title="Milestone updated">
  The due date moved to 23 October.
</Alert.alert>
<Alert.alert kind={:ok} title="Review published">
  Your comments are now visible on the pull request.
</Alert.alert>
<Alert.alert kind={:ai} title="Suggested by the AI">
  Two functions can be merged into one with a single pipeline.
</Alert.alert>
<Alert.alert kind={:risk} title="Could not publish">
  GitHub answered with a 500. Try again in a few minutes.
</Alert.alert>
