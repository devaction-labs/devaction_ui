<%!-- title: With Icon | text: The icon slot carries the meaning beside the color --%>
<Alert.alert kind={:info} title="Contract signed">
  <:icon><.icon name="contracts" class="size-4" /></:icon>
  Both parties signed on 02/10.
</Alert.alert>
<Alert.alert kind={:ok} title="Invoice paid">
  <:icon><.icon name="checkmark-circle-02" class="size-4" /></:icon>
  Invoice 0042 was settled by the client.
</Alert.alert>
<Alert.alert kind={:ai} title="Review ready">
  <:icon><.icon name="sparkles" class="size-4" /></:icon>
  Found 3 suggestions in 12 changed files.
</Alert.alert>
<Alert.alert kind={:risk} title="Payment failed">
  <:icon><.icon name="alert-02" class="size-4" /></:icon>
  The card was declined by the bank.
</Alert.alert>
