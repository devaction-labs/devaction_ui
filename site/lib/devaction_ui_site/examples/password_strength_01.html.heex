<%!-- title: The Four Scores | text: Red, amber, blue and green bars from the tones, and the line under them in the colour of the score; a score of 0 is four empty bars and a muted line. --%>
<div class="grid gap-6 md:grid-cols-2">
  <PasswordStrength.password_strength
    :for={
      {score, label} <- [
        {0, "Type a password"},
        {1, "Weak"},
        {2, "Fair"},
        {3, "Good"},
        {4, "Strong"}
      ]
    }
    score={score}
    label={label}
    meter_label="Password strength"
    rules={[]}
  />
</div>
