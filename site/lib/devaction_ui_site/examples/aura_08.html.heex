<%!-- title: Fast | text: `speed: :fast` turns in 1.4 s, the small chip of the canvas. | layout: center --%>
<div class="flex flex-wrap items-center gap-6">
  <Aura.aura speed={:fast} shape={:pill} aria-busy="true">
    <div class="bg-card px-3 py-1 text-xs text-ink">Thinking</div>
  </Aura.aura>
  <Aura.aura speed={:fast} variant={:dual} aria-busy="true">
    <div class="bg-card px-4 py-3 text-sm text-ink">Reviewing</div>
  </Aura.aura>
</div>
