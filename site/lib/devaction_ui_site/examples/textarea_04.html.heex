<%!-- title: Invalid | text: The invalid state with the message under the field. --%>
<div class="flex max-w-lg flex-col gap-1.5">
  <label for="textarea-invalid" class="text-sm font-medium">Reason for the refund</label>
  <Textarea.textarea id="textarea-invalid" name="reason" rows={2} invalid />
  <span class="text-[13px] text-tag-risk-text">Required for the audit trail.</span>
</div>
