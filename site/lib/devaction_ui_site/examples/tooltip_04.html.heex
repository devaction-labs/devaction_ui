<%!-- title: Rich | text: With a title, the tooltip gets a heading and a paragraph in a wider box | layout: center --%>
<div class="py-12">
  <Tooltip.tooltip
    id="tooltip-rich"
    title="RingScore 69"
    text="18 of 26 scope items approved by the client."
    placement={:bottom}
  >
    <Button.button variant={:secondary} size={:sm}>RingScore</Button.button>
  </Tooltip.tooltip>
</div>
