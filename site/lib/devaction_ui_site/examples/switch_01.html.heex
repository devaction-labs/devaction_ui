<%!-- title: Basic | text: Off, on, disabled and saving. | layout: center --%>
<div class="flex flex-wrap items-center gap-6">
  <span class="flex items-center gap-2.5 text-sm">
    <Switch.switch id="switch-off" label="Off" /> Off
  </span>
  <span class="flex items-center gap-2.5 text-sm">
    <Switch.switch id="switch-on" label="On" checked /> On
  </span>
  <span class="flex items-center gap-2.5 text-sm">
    <Switch.switch id="switch-disabled" label="Disabled" disabled /> Disabled
  </span>
  <span class="flex items-center gap-2.5 text-sm">
    <Switch.switch id="switch-saving" label="Saving" checked saving /> Saving
  </span>
</div>
