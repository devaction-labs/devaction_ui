<%!-- title: Disabled | text: Locked once the contract is signed. | layout: center --%>
<NumberInput.number_input
  id="number-input-disabled"
  name="locked"
  value={3}
  label="Seats"
  min={1}
  max={5}
  event="seats_step"
  decrease_label="Fewer seats"
  increase_label="More seats"
  disabled
>
  <:minus_icon>−</:minus_icon>
  <:plus_icon>+</:plus_icon>
</NumberInput.number_input>
