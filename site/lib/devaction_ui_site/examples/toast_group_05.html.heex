<%!-- title: Positions | text: bottom-right is the default; the group can sit at any corner or centre. Here they are inline, inside their stage. --%>
<div class="grid w-full gap-3 lg:grid-cols-2">
  <div
    :for={
      {position, align} <-
        [
          {"bottom-right", "items-end"},
          {"bottom-left", "items-end"},
          {"bottom-center", "items-end"},
          {"top-right", "items-start"},
          {"top-left", "items-start"},
          {"top-center", "items-start"}
        ]
    }
    class="grid gap-1"
  >
    <span class="font-mono text-xs text-muted">{position}</span>
    <div class={["flex h-24", align]}>
      <ToastGroup.toast_group
        id={"toast-position-#{position}"}
        inline
        position={position}
        duration={0}
        hotkey={false}
        flash={%{"info" => "Changes saved."}}
        label={"Notifications #{position}"}
        dismiss_label="Close"
        class="w-full"
      />
    </div>
  </div>
</div>
