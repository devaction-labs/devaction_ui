<%!-- title: With a toolbar | text: A row under the tabs for the search and the filters of a list, with the count of results at its end. --%>
<PageHeader.page_header id="page-header-toolbar">
  <:title>Projects</:title>
  <:subtitle>6 active across 4 clients</:subtitle>
  <:actions><Button.button size={:sm}>New project</Button.button></:actions>
  <:toolbar>
    <Button.button variant={:secondary} size={:sm}>All clients</Button.button>
    <Button.button variant={:secondary} size={:sm}>Active</Button.button>
  </:toolbar>
  <:toolbar_end>6 results</:toolbar_end>
</PageHeader.page_header>
