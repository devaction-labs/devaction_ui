<%!-- title: Dot | text: Every tone, with a label for assistive technology | layout: center --%>
<div class="flex flex-wrap items-center gap-4">
  <Badge.dot tone={:ok} label="Connected" />
  <Badge.dot tone={:warn} label="Pending" />
  <Badge.dot tone={:risk} label="Failing" />
  <Badge.dot tone={:info} label="Syncing" />
  <Badge.dot tone={:neutral} label="Idle" />
</div>
