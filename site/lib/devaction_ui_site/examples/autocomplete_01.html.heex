<%!-- title: Basic | text: Type to search; results arrive from the server through the search event --%>
<Autocomplete.autocomplete
  id="autocomplete-basic"
  label="Search"
  placeholder="Search lessons and pull requests"
  value={@q}
  event="search"
  groups={@groups}
  empty="Nothing found"
  class="max-w-md"
>
  <:search_icon><.icon name="search-01" class="size-4" /></:search_icon>
</Autocomplete.autocomplete>
