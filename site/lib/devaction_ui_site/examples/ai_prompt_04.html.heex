<%!-- title: Waiting for the answer | text: While `loading` the form is busy and the send button is off. --%>
<AiPrompt.ai_prompt
  id="ai-prompt-loading"
  event="prompt"
  label="Ask the AI"
  send_label="Send"
  value="Summarize the open pull requests for milestone M3"
  loading
  class="max-w-lg"
>
  <:icon><.icon name="arrow-down-01" class="size-4 rotate-180" /></:icon>
</AiPrompt.ai_prompt>
