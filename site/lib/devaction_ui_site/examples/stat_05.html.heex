<%!-- title: Highlight | text: The inverted version, for the one number a screen is about. --%>
<div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
  <Stat.stat label="Current milestone" highlight>M3</Stat.stat>
  <Stat.stat label="Delivered" highlight>
    78<:unit>%</:unit>
    <:trend>
      <.tag variant={:ok} size={:sm} surface={:plain}>+6 pts</.tag>
    </:trend>
    <:hint>since Monday</:hint>
  </Stat.stat>
  <Stat.stat label="Approved" bordered={false}>168</Stat.stat>
</div>
