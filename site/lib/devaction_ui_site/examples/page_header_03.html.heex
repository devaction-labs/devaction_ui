<%!-- title: Status and actions | text: A tag beside the title and the buttons at the end. --%>
<PageHeader.page_header id="page-header-actions">
  <:title>Milestone 3 Finance</:title>
  <:status>
    <.tag variant={:risk}>AT RISK</.tag>
  </:status>
  <:subtitle>Due Oct 23, 18 of 26 items approved</:subtitle>
  <:actions>
    <Button.button>Export</Button.button>
    <Button.button variant={:primary}>Send for approval</Button.button>
  </:actions>
</PageHeader.page_header>
