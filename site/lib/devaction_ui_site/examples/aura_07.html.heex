<%!-- title: Shapes | text: The ring follows the shape of what it wraps: card, pill or circle. | layout: center --%>
<div class="flex flex-wrap items-center gap-6">
  <Aura.aura shape={:card} aria-busy="true">
    <div class="bg-card px-4 py-3 text-sm text-ink">card</div>
  </Aura.aura>
  <Aura.aura shape={:pill} aria-busy="true">
    <div class="bg-card px-5 py-2 text-sm text-ink">pill</div>
  </Aura.aura>
  <Aura.aura shape={:circle} aria-busy="true">
    <div class="grid size-14 place-items-center bg-card text-sm text-ink">AI</div>
  </Aura.aura>
</div>
