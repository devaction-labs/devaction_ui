<%!-- title: AI Agent | text: The agent avatar takes an icon as its mark | layout: center --%>
<div class="flex flex-wrap items-center gap-4">
  <Avatar.agent name="DevAction IA" size={:sm}>
    <.icon name="sparkles" class="size-3.5" />
  </Avatar.agent>
  <Avatar.agent name="DevAction IA" size={:md}>
    <.icon name="sparkles" class="size-4" />
  </Avatar.agent>
  <Avatar.agent size={:lg} name="Review assistant">
    <.icon name="sparkles" class="size-5" />
  </Avatar.agent>
</div>
