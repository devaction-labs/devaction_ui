<%!-- title: Basic | text: A labelled multi-line field with a placeholder. --%>
<div class="flex max-w-lg flex-col gap-1.5">
  <label for="textarea-basic" class="text-sm font-medium">Comment</label>
  <Textarea.textarea
    id="textarea-basic"
    name="comment"
    rows={3}
    placeholder="Leave a note for the reviewer"
  />
</div>
