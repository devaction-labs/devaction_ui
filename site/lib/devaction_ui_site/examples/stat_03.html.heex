<%!-- title: With unit | text: The unit slot sits beside the value, muted and smaller. --%>
<div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
  <Stat.stat label="Scope items">
    7<:unit>/12</:unit>
  </Stat.stat>
  <Stat.stat label="Ready">
    78,4<:unit>%</:unit>
  </Stat.stat>
  <Stat.stat label="Budget">
    R$ 48,2<:unit>k</:unit>
  </Stat.stat>
</div>
