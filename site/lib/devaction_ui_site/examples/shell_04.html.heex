<%!-- title: List and detail | text: `variant="split"` puts a `list` column between the sidebar and the page, for inboxes and reviews. --%>
<div class="overflow-hidden rounded-2xl">
  <Shell.shell
    id="shell-split"
    variant="split"
    style="--shell-h: 420px"
    sidebar_open={false}
    sidebar_label="Main"
    open_label="Open the menu"
    close_label="Collapse the menu"
  >
    <:toggle_icon><.icon name="menu-01" class="size-[18px]" /></:toggle_icon>
    <:sidebar>
      <Shell.sidebar_head name="DevAction IA">
        <:logo>
          <span class="grid size-full place-items-center bg-ink text-xs font-semibold text-on-ink">DA</span>
        </:logo>
      </Shell.sidebar_head>
      <Shell.sidebar_nav>
        <Shell.sidebar_item tip="Reviews" href="#reviews" current>
          <:icon><.icon name="git-pull-request" class="size-full" /></:icon>
          Reviews
        </Shell.sidebar_item>
        <Shell.sidebar_item tip="Projects" href="#projects">
          <:icon><.icon name="folder-01" class="size-full" /></:icon>
          Projects
        </Shell.sidebar_item>
      </Shell.sidebar_nav>
    </:sidebar>
    <:list>
      <ul class="m-0 flex list-none flex-col p-2">
        <li class="rounded-lg bg-wrap px-3 py-2.5 text-sm font-medium text-ink">
          #142 Tithe in transaction
        </li>
        <li class="px-3 py-2.5 text-sm text-ink-2">#141 Fix the milestone due date</li>
        <li class="px-3 py-2.5 text-sm text-ink-2">#139 Contract PDF export</li>
      </ul>
    </:list>
    <:header>
      <Breadcrumb.breadcrumb label="You are here" items={[%{label: "Reviews"}, %{label: "#142"}]} />
    </:header>
    The selected review.
  </Shell.shell>
</div>
