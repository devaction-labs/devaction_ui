<%!-- title: Toolbar, Density and Footer | text: A toolbar above (a search), a toggle for the density at its end, and a footer below with the range of the page and a pagination. --%>
<DataTable.data_table
  select_all_label="Select all"
  select_row_label="Select row"
  selected_label="__COUNT__ selected"
  clear_label="Clear"
  id="data-table-frame"
  label="Open pull requests"
  density_label="Compact rows"
  rows={[
    %{id: "142", title: "Tithe in transaction", author: "carlos-andre", changes: 187},
    %{id: "145", title: "Refunds and CSV export", author: "carlos-andre", changes: 120},
    %{id: "63", title: "Search with filters", author: "alex-nogueira", changes: 33}
  ]}
>
  <:toolbar>
    <div class="w-full max-w-xs">
      <InputGroup.input_group
        id="data-table-frame-search"
        type="search"
        placeholder="Search"
        aria-label="Search pull requests"
      >
        <:icon><.icon name="search-01" class="size-full" /></:icon>
      </InputGroup.input_group>
    </div>
  </:toolbar>
  <:density_icon><.icon name="filter" class="size-4" /></:density_icon>
  <:col :let={row} label="PR" class="font-mono">#{row.id}</:col>
  <:col :let={row} label="Title">{row.title}</:col>
  <:col :let={row} label="Author" class="text-ink-2">{row.author}</:col>
  <:col :let={row} label="Changes" class="font-mono">{row.changes}</:col>
  <:footer>
    <span>1-3 of 33</span>
    <Pagination.pagination
      size={:sm}
      page={1}
      pages={11}
      kind={:href}
      path={&"#page-#{&1}"}
      label="Pages"
      previous="Previous page"
      next="Next page"
    />
  </:footer>
</DataTable.data_table>
