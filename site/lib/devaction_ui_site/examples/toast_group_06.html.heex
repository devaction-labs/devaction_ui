<%!-- title: Flash | text: The flash of the socket becomes toasts: info shows as ok and error as risk. --%>
<div class="grid w-full gap-3">
  <div class="flex flex-wrap gap-2">
    <Button.button
      id="toast-flash-info"
      variant={:secondary}
      size={:sm}
      phx-click="toast_flash"
      phx-value-kind="info"
    >
      put_flash :info
    </Button.button>
    <Button.button
      id="toast-flash-error"
      variant={:secondary}
      size={:sm}
      phx-click="toast_flash"
      phx-value-kind="error"
    >
      put_flash :error
    </Button.button>
  </div>
  <div class="flex h-[200px] items-end">
    <ToastGroup.toast_group
      id="toast-flash"
      inline
      flash={@flash}
      label="Notifications (Alt+T)"
      dismiss_label="Close"
    />
  </div>
</div>
