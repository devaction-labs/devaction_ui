<%!-- title: Single Date | text: Pick one day; a minimum date disables earlier days --%>
<DatePicker.date_picker
  id="date-picker-single"
  name="due_single"
  today="2026-10-14"
  value="2026-10-16"
  min="2026-10-10"
  previous_label="Previous month"
  next_label="Next month"
  inside_label="in the range"
  shadow
>
  <:prev_icon><.icon name="arrow-down-01" class="size-3 rotate-90" /></:prev_icon>
  <:next_icon><.icon name="arrow-down-01" class="size-3 -rotate-90" /></:next_icon>
</DatePicker.date_picker>
