<%!-- title: Loading to done | text: A loading toast never leaves by itself. The server turns it into ok or risk with update_toast and the same id. --%>
<div class="grid w-full gap-3">
  <div class="flex flex-wrap gap-2">
    <Button.button
      id="toast-report-ok"
      variant={:primary}
      size={:sm}
      phx-click="toast_report"
      phx-value-result="ok"
    >
      Generate report
    </Button.button>
    <Button.button
      id="toast-report-fail"
      variant={:secondary}
      size={:sm}
      phx-click="toast_report"
      phx-value-result="risk"
    >
      Generate and fail
    </Button.button>
  </div>
  <div class="flex h-[140px] items-end">
    <ToastGroup.toast_group
      id="toast-report"
      inline
      label="Notifications (Alt+T)"
      dismiss_label="Close"
    />
  </div>
</div>
