<%!-- title: Shortcuts | text: Quick picks listed beside the calendar --%>
<DatePicker.date_picker
  id="date-picker-shortcuts"
  name="due_shortcuts"
  today="2026-10-14"
  value="2026-10-14"
  previous_label="Previous month"
  next_label="Next month"
>
  <:shortcut date="2026-10-14">Today</:shortcut>
  <:shortcut date="2026-10-15">Tomorrow</:shortcut>
  <:shortcut date="2026-10-16">Friday</:shortcut>
  <:shortcut date="2026-10-21">In 7 days</:shortcut>
</DatePicker.date_picker>
