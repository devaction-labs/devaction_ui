<%!-- title: Centered | text: `variant="centered"` keeps the page in a narrow column under a top bar, for forms and settings. --%>
<div class="overflow-hidden rounded-2xl">
  <Shell.shell
    id="shell-centered"
    variant="centered"
    style="--shell-h: 360px"
    sidebar_label="Main"
    open_label="Open the menu"
    close_label="Collapse the menu"
  >
    <:sidebar>
      <Shell.sidebar_head name="DevAction IA">
        <:logo>
          <span class="grid size-full place-items-center bg-ink text-xs font-semibold text-on-ink">DA</span>
        </:logo>
      </Shell.sidebar_head>
      <Shell.sidebar_nav>
        <Shell.sidebar_item tip="Account" href="#account" current>Account</Shell.sidebar_item>
        <Shell.sidebar_item tip="Billing" href="#billing">Billing</Shell.sidebar_item>
      </Shell.sidebar_nav>
    </:sidebar>
    <:header>
      <Breadcrumb.breadcrumb
        label="You are here"
        items={[%{label: "Account"}, %{label: "Profile"}]}
      />
    </:header>
    <PageHeader.page_header id="shell-centered-head">
      <:title>Profile</:title>
      <:subtitle>How you appear to the rest of the team</:subtitle>
    </PageHeader.page_header>
  </Shell.shell>
</div>
