<%!-- title: Groups | text: Groups become optgroup and a disabled option stays visible. With a mouse the open list is a styled panel; on a phone it is the system picker --%>
<div class="max-w-sm">
  <label for="select-role" class="block text-sm font-medium text-ink">Role</label>
  <Select.select
    id="select-role"
    name="role"
    value="dev"
    class="mt-1.5"
    options={[
      {"Team", [%{value: "dev", label: "Developer"}, %{value: "pm", label: "Product manager"}]},
      {"Client",
       [%{value: "owner", label: "Owner"}, %{value: "viewer", label: "Read only", disabled: true}]}
    ]}
  >
    <:icon><.icon name="user-group" /></:icon>
    <:chevron_icon><.icon name="arrow-down-01" /></:chevron_icon>
  </Select.select>
  <p class="m-0 mt-2 text-sm text-ink-2">
    Open it: the groups are the headers, the chosen option has a check and
    <code class="font-mono text-xs">Read only</code>
    cannot be chosen.
  </p>
</div>
