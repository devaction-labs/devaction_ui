<%!-- title: Basic | text: A single thumb with the value shown beside the label. --%>
<form id="slider-basic-form" phx-change="inputs_change" class="m-0 max-w-sm">
  <Slider.slider
    id="slider-basic"
    name="hours"
    label="Hours per week"
    value={@inputs.hours}
    min={0}
    max={40}
  />
</form>
