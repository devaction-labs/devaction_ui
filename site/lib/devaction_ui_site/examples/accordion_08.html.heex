<%!-- title: Chevron at the start | text: A plain accordion that opens with the chevron before the title, as in the nested canvas --%>
<Accordion.accordion id="acc-start" variant={:plain} chevron={:start}>
  <:item title="Contracts" count="3" open>
    Three contracts are running and none is late.
  </:item>
  <:item title="Milestones" count="12">
    Twelve milestones, two of them due this month.
  </:item>
</Accordion.accordion>
