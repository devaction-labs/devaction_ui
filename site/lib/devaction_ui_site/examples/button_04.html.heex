<%!-- title: With Icon | text: An icon before or after the label | layout: center --%>
<div class="flex flex-wrap items-center gap-2.5">
  <Button.button variant={:primary}>
    <.icon name="git-pull-request" class="size-4" /> Open pull request
  </Button.button>
  <Button.button variant={:ai}>
    <.icon name="sparkles" class="size-4" /> Review with AI
  </Button.button>
  <Button.button>
    Next milestone <.icon name="arrow-right-01" class="size-4" />
  </Button.button>
</div>
