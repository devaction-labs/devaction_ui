<%!-- title: Key and value | text: A small summary with a pair of actions --%>
<div class="pb-52">
  <Popover.popover id="popover-details" label="Contract summary">
    <:trigger>
      <Button.button variant={:secondary} size={:sm}>Contract summary</Button.button>
    </:trigger>
    <dl class="m-0 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-sm">
      <dt class="text-ink-2">Client</dt>
      <dd class="m-0 text-right font-medium text-ink">M3 Finance</dd>
      <dt class="text-ink-2">Milestone</dt>
      <dd class="m-0 text-right font-medium text-ink">M3, due Nov 30</dd>
      <dt class="text-ink-2">Hours</dt>
      <dd class="m-0 text-right font-medium text-ink">86 of 120</dd>
    </dl>
    <div class="mt-3 flex gap-2">
      <Button.button size={:sm} variant={:primary}>Open</Button.button>
      <Button.button size={:sm} variant={:ghost}>Later</Button.button>
    </div>
  </Popover.popover>
</div>
