<%!-- title: Named, with a copy button | text: A label names the region for the keyboard; `copy_label` adds the button (the CodeCopy hook). --%>
<.code_block
  id="code-block-copy"
  label="Suggested fix"
  copy_label="Copy"
  copied_label="Copied"
  code="Multi.new()\n|> Multi.insert(:invoice, changeset)\n|> Repo.transaction()"
/>
