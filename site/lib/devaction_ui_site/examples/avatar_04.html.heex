<%!-- title: Square | text: Square avatars stand for workspaces, repositories and clients | layout: center --%>
<div class="flex flex-wrap items-center gap-4">
  <Avatar.avatar name="DevAction Labs" shape={:square} size={:lg} tone={:info} />
  <Avatar.avatar name="sge-api" shape={:square} size={:lg} tone={:ok} />
  <Avatar.avatar name="Acme Church" shape={:square} size={:lg} />
  <Avatar.avatar name="sge-web" shape={:square} size={:lg} tone={:neutral}>
    <:icon><.icon name="add-01" class="size-full" /></:icon>
  </Avatar.avatar>
</div>
