<%!-- title: Sizes | text: Small, medium and large in the same variant | layout: center --%>
<div class="flex flex-wrap items-center gap-2.5">
  <Button.button variant={:primary} size={:sm}>Small</Button.button>
  <Button.button variant={:primary} size={:md}>Medium</Button.button>
  <Button.button variant={:primary} size={:lg}>Large</Button.button>
</div>
