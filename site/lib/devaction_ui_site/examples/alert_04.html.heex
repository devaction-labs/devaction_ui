<%!-- title: Title Only | text: The body is optional --%>
<Alert.alert kind={:ok} title="Changes saved">
  <:icon><.icon name="checkmark-circle-02" class="size-4" /></:icon>
</Alert.alert>
<Alert.alert kind={:risk} title="Repository disconnected">
  <:icon><.icon name="alert-02" class="size-4" /></:icon>
</Alert.alert>
