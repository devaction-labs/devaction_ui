<%!-- title: Empty | text: The pill with a placeholder, waiting for the first question. --%>
<AiPrompt.ai_prompt
  id="ai-prompt-empty"
  event="prompt"
  label="Ask the AI"
  send_label="Send"
  placeholder="Ask about this project..."
  class="max-w-lg"
>
  <:icon><.icon name="arrow-down-01" class="size-4 rotate-180" /></:icon>
</AiPrompt.ai_prompt>
