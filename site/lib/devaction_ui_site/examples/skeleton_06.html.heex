<%!-- title: Line sizes | text: A line is 14, 12 or 10 px high: a text line, a row of a list and the label of a number. --%>
<.skeleton_group label="Loading" class="grid max-w-sm gap-3">
  <.skeleton size={:md} class="w-3/4" />
  <.skeleton size={:sm} class="w-2/3" />
  <.skeleton size={:xs} class="w-1/3" />
  <.skeleton shape={:block} animate={false} />
</.skeleton_group>
