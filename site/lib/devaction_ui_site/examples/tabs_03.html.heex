<%!-- title: Line | text: An underlined variant for page-level sections. --%>
<Tabs.tabs id="tabs-line" label="Milestones" variant={:line}>
  <:tab id="tabs-line-due" label="Due" count="3">Three milestones are due this month.</:tab>
  <:tab id="tabs-line-review" label="In review">Two milestones are being reviewed.</:tab>
  <:tab id="tabs-line-done" label="Delivered">Eleven milestones were delivered.</:tab>
</Tabs.tabs>
