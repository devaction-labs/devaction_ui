<%!-- title: Dots | text: Three dots that pulse one after the other, for an answer being written; they stand still under reduced motion. | layout: center --%>
<div class="flex items-center gap-6 text-sm text-ink">
  <.dots label="The AI is answering" />
  <span class="inline-flex items-center gap-2">
    <.dots label="Reviewing" tone={:warn} /> Reviewing the diff
  </span>
</div>
