<%!-- title: Kinds | text: The five canvas kinds, each with an icon --%>
<.callout kind={:note} title="Note">
  <:icon><.icon name="contracts" class="size-4" /></:icon>
  The contract renews on 1 January.
</.callout>
<.callout kind={:ai} title="The AI did this">
  <:icon><.icon name="sparkles" class="size-4" /></:icon>
  It summarised 14 comments and grouped them by file.
</.callout>
<.callout kind={:tip} title="Tip">
  <:icon><.icon name="bulb" class="size-4" /></:icon>
  Press the shortcut to jump to the next unresolved thread.
</.callout>
<.callout kind={:warning} title="Warning">
  <:icon><.icon name="alert-02" class="size-4" /></:icon>
  Two reviewers are still missing on this pull request.
</.callout>
<.callout kind={:decision} title="Decision">
  <:icon><.icon name="checkmark-circle-02" class="size-4" /></:icon>
  The team agreed to ship the members module first.
</.callout>
