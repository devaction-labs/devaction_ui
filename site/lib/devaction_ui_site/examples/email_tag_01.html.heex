<%!-- title: Tones | text: Five tones carry the meaning. The label is always text, written in capitals, because a mail client does not always honor text-transform. --%>
<div class="flex flex-wrap items-center gap-2">
  <EmailTag.tag tone={:risk}>RISK</EmailTag.tag>
  <EmailTag.tag tone={:warn}>ATTENTION</EmailTag.tag>
  <EmailTag.tag tone={:info}>SUGGESTION</EmailTag.tag>
  <EmailTag.tag tone={:ok}>OK</EmailTag.tag>
  <EmailTag.tag tone={:neutral}>INFO</EmailTag.tag>
</div>
