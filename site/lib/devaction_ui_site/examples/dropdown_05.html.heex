<%!-- title: Size and alignment | text: The small button, and a menu aligned to the end of the trigger --%>
<div class="flex items-start justify-between gap-4 pb-48">
  <Dropdown.dropdown id="dropdown-small" label="Filter" size={:sm}>
    <:trigger><.icon name="filter" class="size-4" /> Filter</:trigger>
    <:item event="overlay_close">Open pull requests</:item>
    <:item event="overlay_close">Needs review</:item>
  </Dropdown.dropdown>
  <Dropdown.dropdown id="dropdown-end" label="More" align={:end} size={:sm}>
    <:trigger><.icon name="more-horizontal" class="size-4" /> More</:trigger>
    <:item event="overlay_close">Export CSV</:item>
    <:item event="overlay_close">Print</:item>
  </Dropdown.dropdown>
</div>
