<%!-- title: Donut chart | text: A ring for parts of a whole, with the total in the centre. --%>
<Chart.donut_chart
  id="chart-donut"
  summary="Scope of M3 by status"
  items={[
    %{label: "Approved", value: 18},
    %{label: "In review", value: 5},
    %{label: "No PR", value: 3}
  ]}
>
  <:center>
    <strong class="text-2xl">26</strong><span class="text-xs text-muted">items</span>
  </:center>
</Chart.donut_chart>
