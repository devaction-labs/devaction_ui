<%!-- title: Tones | text: The inverse cap for dark surfaces, the bare text for menus and the larger cap | layout: center --%>
<div class="flex flex-wrap items-center gap-4">
  <.kbd>⌘K</.kbd>
  <.kbd size={:md}>Esc</.kbd>
  <span class="inline-flex rounded-lg bg-ink px-3 py-2">
    <.kbd tone={:inverse}>⌘B</.kbd>
  </span>
  <.kbd tone={:bare}>⌘E</.kbd>
</div>
