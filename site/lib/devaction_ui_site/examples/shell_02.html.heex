<%!-- title: Rail | text: The server renders the collapsed state with `sidebar_open={false}` (read from the cookie); each item shows its name on hover, a dot marks a pull request that needs attention, and the groups become blocks between lines. --%>
<div class="overflow-hidden rounded-2xl">
  <Shell.shell
    id="shell-rail"
    style="--shell-h: 420px"
    sidebar_open={false}
    sidebar_label="Main"
    open_label="Open the menu"
    close_label="Collapse the menu"
  >
    <:toggle_icon><.icon name="menu-01" class="size-[18px]" /></:toggle_icon>
    <:sidebar>
      <Shell.sidebar_head name="DevAction IA">
        <:logo>
          <span class="grid size-full place-items-center bg-ink text-xs font-semibold text-on-ink">DA</span>
        </:logo>
      </Shell.sidebar_head>
      <Shell.sidebar_nav>
        <Shell.sidebar_item tip="Today" href="#today" current>
          <:icon><.icon name="home-01" class="size-full" /></:icon>
          Today
        </Shell.sidebar_item>
        <Shell.sidebar_group id="shell-rail-work" label="Work">
          <:icon><.icon name="arrow-down-01" class="size-full" /></:icon>
          <Shell.sidebar_item tip="Projects" href="#projects">
            <:icon><.icon name="folder-01" class="size-full" /></:icon>
            Projects
          </Shell.sidebar_item>
          <Shell.sidebar_item tip="Pull requests" href="#prs" dot>
            <:icon><.icon name="git-pull-request" class="size-full" /></:icon>
            Pull requests
          </Shell.sidebar_item>
        </Shell.sidebar_group>
      </Shell.sidebar_nav>
    </:sidebar>
    <:header>
      <Breadcrumb.breadcrumb label="You are here" items={[%{label: "Today"}]} />
    </:header>
    The page.
  </Shell.shell>
</div>
