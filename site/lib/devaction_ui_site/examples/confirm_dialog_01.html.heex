<%!-- title: Basic | text: A short question before publishing; the confirming button says what it does --%>
<div class="flex flex-wrap items-center gap-3">
  <Button.button id="confirm-dialog-open" size={:sm} phx-click="confirm_open">
    Publish review
  </Button.button>
  <.tag :if={@published} variant={:ok}>Published on GitHub</.tag>
</div>
<ConfirmDialog.confirm_dialog
  :if={@confirming}
  id="confirm-dialog-basic"
  title="Publish the review on GitHub?"
  on_cancel="confirm_cancel"
>
  <:icon><.icon name="git-pull-request" class="size-5" /></:icon>
  10 comments will be published on sge-api #142 as "request changes". 2 dismissed findings stay only here.
  <:actions>
    <Button.button id="confirm-dialog-cancel" variant={:secondary} phx-click="confirm_cancel">
      Cancel
    </Button.button>
    <Button.button id="confirm-dialog-ok" phx-click="confirm_publish">Publish</Button.button>
  </:actions>
</ConfirmDialog.confirm_dialog>
