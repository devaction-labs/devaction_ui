<%!-- title: Sizes | text: Three heights, as the other fields: :sm 36px, :md 44px and :lg 52px; the mono word only names the size --%>
<div class="max-w-sm">
  <div class="flex flex-col gap-2.5">
    <div class="relative">
      <Select.select
        id="select-sm"
        name="sm"
        size={:sm}
        aria-label="Small"
        value="sm"
        options={[{"Small", "sm"}]}
      >
        <:chevron_icon><.icon name="arrow-down-01" /></:chevron_icon>
      </Select.select>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute top-1/2 right-[37px] -translate-y-1/2 font-mono text-[11px] text-muted"
      >
        :sm
      </span>
    </div>
    <div class="relative">
      <Select.select
        id="select-md"
        name="md"
        aria-label="Medium"
        value="md"
        options={[{"Medium", "md"}]}
      >
        <:chevron_icon><.icon name="arrow-down-01" /></:chevron_icon>
      </Select.select>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute top-1/2 right-[39px] -translate-y-1/2 font-mono text-[11px] text-muted"
      >
        :md
      </span>
    </div>
    <div class="relative">
      <Select.select
        id="select-lg"
        name="lg"
        size={:lg}
        aria-label="Large"
        value="lg"
        options={[{"Large", "lg"}]}
      >
        <:chevron_icon><.icon name="arrow-down-01" /></:chevron_icon>
      </Select.select>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute top-1/2 right-[41px] -translate-y-1/2 font-mono text-[11px] text-muted"
      >
        :lg
      </span>
    </div>
  </div>
</div>
