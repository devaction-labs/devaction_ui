<%!-- title: Tones | text: A plain tone can be used as the kind --%>
<div class="grid gap-3 md:grid-cols-2">
  <.callout kind={:ok} title="Ok">All checks passed on the last commit.</.callout>
  <.callout kind={:info} title="Info">A new version of the contract is available.</.callout>
  <.callout kind={:warn} title="Warn">The invoice is due in two days.</.callout>
  <.callout kind={:risk} title="Risk">The milestone is late by five days.</.callout>
  <.callout kind={:neutral} title="Neutral">No activity in the last week.</.callout>
</div>
