<%!-- title: Elixir with line numbers | text: `lang: :elixir` colours the code; `line_numbers` is generated by CSS, so the copy has none. --%>
<.code_block
  id="code-block-elixir"
  lang={:elixir}
  line_numbers
  label="invoice.ex"
  copy_label="Copy"
  copied_label="Copied"
  code="def pay(%Invoice{} = invoice) do\n  with {:ok, paid} <- Repo.update(change(invoice, status: :paid)) do\n    # notify the team\n    {:ok, paid}\n  end\nend"
/>
