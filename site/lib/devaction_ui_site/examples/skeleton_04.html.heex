<%!-- title: Loading card | text: A pull request card while its data is on the way. --%>
<.panel id="skeleton-card" label="Loading pull request" class="max-w-md">
  <div class="flex items-center gap-3">
    <.skeleton shape={:circle} class="size-10" />
    <div class="flex flex-1 flex-col gap-2">
      <.skeleton class="w-1/3" />
      <.skeleton class="w-1/2" />
    </div>
  </div>
  <.skeleton shape={:block} class="h-24 w-full" />
  <div class="flex gap-2">
    <.skeleton class="w-16" />
    <.skeleton class="w-20" />
  </div>
</.panel>
