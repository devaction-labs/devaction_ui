<%!-- title: Tones | text: A tinted notice in each of the five tones. Start it with an emphasis to give it a lead. --%>
<div class="max-w-[520px]">
  <EmailCallout.callout tone={:risk} lead="Was it not you?">
    Reset your password now and review the connected devices.
  </EmailCallout.callout>
  <EmailCallout.callout tone={:warn}>
    Need to sign in right now? Use the magic link on the sign-in screen.
  </EmailCallout.callout>
  <EmailCallout.callout tone={:info}>The invite works for 7 days.</EmailCallout.callout>
  <EmailCallout.callout tone={:ok}>Your new password is active.</EmailCallout.callout>
  <EmailCallout.callout>We keep a copy of this e-mail in your account.</EmailCallout.callout>
</div>
