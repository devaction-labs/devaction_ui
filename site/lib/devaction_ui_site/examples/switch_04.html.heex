<%!-- title: Switch row | text: Label and description, with the saving state and the saved note. --%>
<div class="flex max-w-lg flex-col">
  <Switch.switch_row
    :for={
      {key, label, description} <- [
        {"auto_review", "Automatic review", "The AI reviews every open PR."},
        {"weekly", "Weekly summary", "An e-mail on Monday."},
        {"digest", "Daily digest", "Not available on your plan."}
      ]
    }
    id={"switch-row-#{key}"}
    label={label}
    description={description}
    checked={key in @switches.on}
    saving={@switches.saving == key}
    disabled={key == "digest"}
    phx-click="switch_toggle"
    phx-value-key={key}
  />
  <Switch.saved_note :if={@switches.saved} id="switch-saved">Saved now</Switch.saved_note>
</div>
