<%!-- title: With an error | text: The message sits under the field and the field is marked invalid --%>
<ColorPicker.color_picker
  id="color-error"
  name="brand[color]"
  value="#12345"
  label="Brand colour"
  error="Use six hex digits, like #2563EB."
  toggle_label="Open the colour picker"
  area_label="Saturation and brightness"
  hue_label="Hue"
  presets_label="Ready colours"
/>
