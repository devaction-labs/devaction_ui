<%!-- title: States | text: On (ink), off, amber for what needs a look, and the dashed pill that adds a filter. --%>
<div class="flex flex-wrap gap-1.5">
  <FilterPill.filter_pill label="SGE" active />
  <FilterPill.filter_pill label="Hub API" />
  <FilterPill.filter_pill label="Only AI reviewed" tone={:warn} />
  <FilterPill.add_pill label="Filter" />
</div>
