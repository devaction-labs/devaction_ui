<%!-- title: With a suggestion | text: A prefilled value, as when the AI proposes the next question. --%>
<AiPrompt.ai_prompt
  id="ai-prompt-suggestion"
  event="prompt"
  label="Ask the AI"
  send_label="Send"
  value="Summarize the open pull requests for milestone M3"
  class="max-w-lg"
>
  <:icon><.icon name="arrow-down-01" class="size-4 rotate-180" /></:icon>
</AiPrompt.ai_prompt>
