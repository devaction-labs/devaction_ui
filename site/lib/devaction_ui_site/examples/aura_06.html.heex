<%!-- title: Around a card | text: A card that keeps its surface while the AI works on it. | layout: center --%>
<Aura.aura variant={:glow} tone={:learning} size={:lg}>
  <div class="flex w-72 flex-col gap-2 bg-card p-4">
    <.eyebrow>AI review</.eyebrow>
    <p class="text-sm text-ink">Reading 14 changed files in Add Pix payment method.</p>
    <.progress label="Reading the diff" indeterminate variant={:thin} tone={:warn} />
  </div>
</Aura.aura>
