<%!-- title: Empty Result | text: What the list says when a query finds nothing --%>
<div class="min-h-32">
  <Autocomplete.autocomplete
    id="autocomplete-empty"
    label="Search the workspace"
    value="zzz"
    event="search"
    groups={[]}
    empty="Nothing found for this search"
    class="max-w-md"
  >
    <:search_icon><.icon name="search-01" class="size-4" /></:search_icon>
  </Autocomplete.autocomplete>
</div>
