<%!-- title: Loading and Disabled | text: Busy and unavailable states | layout: center --%>
<div class="flex flex-wrap items-center gap-2.5">
  <Button.button variant={:primary} loading>Publishing review</Button.button>
  <Button.button loading>Saving</Button.button>
  <Button.button variant={:primary} disabled>Approve</Button.button>
  <Button.button disabled>Export report</Button.button>
</div>
