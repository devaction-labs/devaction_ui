<%!-- title: Sizes | text: Small is 36 px, medium 44 px and large 52 px high --%>
<div class="flex max-w-md flex-col gap-3">
  <InputGroup.input_group id="input-group-sm" size={:sm} placeholder="Small · 36">
    <:icon><.icon name="search-01" /></:icon>
  </InputGroup.input_group>
  <InputGroup.input_group id="input-group-md" size={:md} placeholder="Medium · 44">
    <:icon><.icon name="search-01" /></:icon>
  </InputGroup.input_group>
  <InputGroup.input_group id="input-group-lg" size={:lg} placeholder="Large · 52">
    <:icon><.icon name="search-01" /></:icon>
  </InputGroup.input_group>
</div>
