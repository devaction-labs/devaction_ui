<%!-- title: Tones | text: The value takes the tone of what it measures. --%>
<div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
  <Stat.stat label="Total">214</Stat.stat>
  <Stat.stat label="Overdue" tone={:risk}>17</Stat.stat>
  <Stat.stat label="Waiting" tone={:warn}>29</Stat.stat>
  <Stat.stat label="Delivered" tone={:ok}>168</Stat.stat>
</div>
