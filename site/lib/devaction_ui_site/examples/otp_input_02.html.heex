<%!-- title: With a separator | text: `separator_after` splits the code in groups, such as 482 – 913; the separator can be your own slot. | layout: center --%>
<OtpInput.input
  id="otp-separator"
  name="otp_separator"
  label="Verification code"
  box_label="Digit %{n} of %{total}"
  value="4829"
  separator_after={3}
  helper="2 digits to go"
/>
