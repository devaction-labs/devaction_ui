<%!-- title: Variants | text: Seven variants, each with its own meaning | layout: center --%>
<div class="flex flex-wrap items-center gap-2.5">
  <Button.button variant={:primary}>Approve</Button.button>
  <Button.button variant={:secondary}>Save draft</Button.button>
  <Button.button variant={:ghost}>Cancel</Button.button>
  <Button.button variant={:ai}>Ask the AI</Button.button>
  <Button.button variant={:danger}>Request changes</Button.button>
  <Button.button variant={:info}>Learn more</Button.button>
  <Button.button variant={:link}>View history</Button.button>
</div>
