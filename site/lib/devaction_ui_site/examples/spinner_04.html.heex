<%!-- title: In a button | text: A busy action keeps its label and swaps the icon for the ring. --%>
<div class="flex flex-wrap items-center gap-3">
  <Button.button disabled>
    <.spinner label="Saving" size={:sm} /> Saving changes
  </Button.button>
  <Button.button variant={:secondary} disabled>
    <.spinner label="Publishing" size={:sm} /> Publishing
  </Button.button>
</div>
