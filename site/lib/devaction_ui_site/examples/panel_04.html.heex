<%!-- title: Custom padding | text: inner_class replaces the default padding and gap. --%>
<div class="grid gap-4 sm:grid-cols-2">
  <.panel id="panel-compact" label="Compact" inner_class="p-4 gap-2">
    <.eyebrow>Compact</.eyebrow>
    <p class="text-sm text-ink">Tighter padding for dense side columns.</p>
  </.panel>
  <.panel id="panel-roomy" label="Roomy" inner_class="p-8 gap-6">
    <.eyebrow>Roomy</.eyebrow>
    <p class="text-sm text-ink">More air for a panel that carries a single message.</p>
  </.panel>
</div>
