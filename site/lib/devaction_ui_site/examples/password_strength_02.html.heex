<%!-- title: Rules With Marks | text: evaluate/2 gives the score and the rules; a rule that is met paints its mark and its words green, one that is not stays muted. Sixteen characters earn a point more. --%>
<div class="grid gap-8 md:grid-cols-2">
  <div
    :for={{password, label} <- [{"Abcdefgh", "Weak"}, {"Abcdefghijkl1", "Good"}]}
    class="flex flex-col gap-2"
  >
    <% strength = PasswordStrength.evaluate(password) %>
    <span class="font-mono text-xs text-muted">{password}</span>
    <PasswordStrength.password_strength
      score={strength.score}
      label={label}
      meter_label="Password strength"
      rules={[
        %{label: "At least 12 characters", met: strength.rules[:length]},
        %{label: "Capital and small letters", met: strength.rules[:mixed_case]},
        %{label: "A number or a symbol", met: strength.rules[:digit_or_symbol]}
      ]}
    >
      <:met_icon><.icon name="checkmark-circle-02" class="size-4" /></:met_icon>
      <:unmet_icon><.icon name="clock-01" class="size-4" /></:unmet_icon>
    </PasswordStrength.password_strength>
  </div>
</div>
