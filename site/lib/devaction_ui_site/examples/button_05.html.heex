<%!-- title: Icon Only | text: A square button with just an icon and an aria-label | layout: center --%>
<div class="flex flex-wrap items-center gap-2.5">
  <Button.button icon_only size={:sm} aria-label="Add task"><.icon name="add-01" class="size-4" /></Button.button>
  <Button.button icon_only variant={:primary} aria-label="Search"><.icon
    name="search-01"
    class="size-4"
  /></Button.button>
  <Button.button icon_only variant={:ghost} size={:lg} aria-label="Settings"><.icon
    name="settings-01"
    class="size-5"
  /></Button.button>
</div>
