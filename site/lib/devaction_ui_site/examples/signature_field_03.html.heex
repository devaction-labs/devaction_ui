<%!-- title: Switching modes | text: The mode lives on the server; try both buttons. --%>
<div class="max-w-lg">
  <SignatureField.signature_field
    id="signature-live"
    name="live_signature"
    mode={@inputs.sign_mode}
    typed="Maria Souza"
    label="Sign here"
    mode_event="sign_mode"
    draw_label="Draw"
    type_label="Type"
    clear_label="Clear"
    pad_label="Signature area"
    empty_label="Signature empty"
    ready_label="Ready to sign"
  >
    <:clear_icon><.icon name="refresh" class="size-4" /></:clear_icon>
  </SignatureField.signature_field>
</div>
