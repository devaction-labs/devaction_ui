<%!-- title: Variants | text: Default, ok, warn, risk, info, ai and loading, each with a title and a description. Only risk is announced as an alert. --%>
<div class="grid w-full gap-3">
  <div class="flex flex-wrap gap-2">
    <Button.button
      :for={variant <- ~w(default ok warn risk info ai loading)}
      id={"toast-variant-#{variant}"}
      variant={:secondary}
      size={:sm}
      phx-click="toast_variant"
      phx-value-variant={variant}
    >
      {variant}
    </Button.button>
  </div>
  <div class="flex h-[300px] items-end">
    <ToastGroup.toast_group
      id="toast-variants"
      inline
      duration={0}
      label="Notifications (Alt+T)"
      dismiss_label="Close"
    />
  </div>
</div>
