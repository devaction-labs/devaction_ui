<%!-- title: Basic | text: A labelled field with a leading icon and a help text below --%>
<label class="flex max-w-sm flex-col gap-1.5 text-sm font-medium">
  E-mail
  <InputGroup.input_group id="input-group-basic" type="email" placeholder="you@company.com">
    <:icon><.icon name="mail-01" /></:icon>
  </InputGroup.input_group>
  <span class="text-[13px] font-normal text-muted">We send the weekly review summary here.</span>
</label>
